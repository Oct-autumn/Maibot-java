<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="maibot-sqlite-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <properties>
            <!-- SQLite数据库驱动配置 -->
            <property name="hibernate.connection.driver_class" value="org.sqlite.JDBC"/>
            <!-- 适配SQLite方言 -->
            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <!-- c3p0连接池配置 -->
            <property name="hibernate.connection.provider_class"
                      value="org.hibernate.c3p0.internal.C3P0ConnectionProvider"/>
            <property name="hibernate.c3p0.min_size" value="1"/>
            <property name="hibernate.c3p0.max_size" value="1"/>
            <property name="hibernate.c3p0.timeout" value="0"/>

            <!-- 不自动创建或更新数据库表结构，在代码中已交给Flyway处理 -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>

            <!-- 启用二级缓存，使用JCache实现 -->
            <property name="hibernate.cache.use_second_level_cache" value="true"/>
            <property name="hibernate.cache.region.factory_class"
                      value="org.hibernate.cache.jcache.JCacheRegionFactory"/>
        </properties>
    </persistence-unit>
</persistence>